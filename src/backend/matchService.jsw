/**
 * Gera um ID único para a partida
 * @returns {string} ID da partida
 */
function generateMatchId() {
  return `match_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
}

/**
 * Aplica a jogada ao estado do jogo
 * Customize esta função com a lógica específica do seu jogo
 * @param {Object} gameData - Estado atual do jogo
 * @param {string} playerId - ID do jogador
 * @param {Object} moveData - Dados da jogada
 * @returns {Object} Estado atualizado
 */
function applyMove(gameData, playerId, moveData) {
  // Exemplo básico - customize conforme necessário
  const updated = { ...gameData };
  
  if (!updated.moves) {
    updated.moves = [];
  }
  
  updated.moves.push({
    playerId,
    move: moveData,
    timestamp: new Date().toISOString()
  });

  // Aplicar lógica específica do jogo aqui
  // Ex: atualizar mão do jogador, tabuleiro, etc.

  return updated;
}


 * @returns {Promise<void>}
 */
export async function publishTerritoryInvasion(targetPlayerId, attackerName, territoryName) {
  try {
    const channel = `attack_${targetPlayerId}`;
    const message = {
      type: 'territoryInvasion',
      attackerName,
      territoryName,
      timestamp: Date.now()
    };

    await publish(channel, message);
    console.log(`Territory invasion published to ${channel}:`, message);
  } catch (error) {

// LEGACY CODE - DO NOT USE
import wixMembers from 'wix-members-backend';
import wixData from 'wix-data';
import { ok, badRequest, unauthorized, serverError } from 'wix-http-functions';

/**
 * Verifica se o usuário está logado
 * @returns {Promise<Object>} { isLoggedIn: boolean, memberId: string|null, email: string|null }
 */
export async function checkIfLoggedIn() {
  try {
    const member = await wixMembers.currentMember.getMember();
    
    if (member) {
      return {
        isLoggedIn: true,
        memberId: member._id,
        email: member.loginEmail,
        nickname: member.profile?.nickname || member.contact?.firstName || 'Jogador',
        profilePhoto: member.profile?.photo?.url || null,
        status: member.status
      };
    } else {
      return {
        isLoggedIn: false,
        memberId: null,
        email: null
      };
    }
  } catch (error) {
    console.error('Erro ao verificar login:', error);
    return {
      isLoggedIn: false,
      memberId: null,
      email: null,
      error: error.message
    };
  }
}

/**
 * Obtém informações do membro atual
 * @returns {Promise<Object>} Dados completos do membro
 */
export async function getCurrentMemberInfo() {
  try {
    const member = await wixMembers.currentMember.getMember();
    
    if (!member) {
      return { error: 'Usuário não autenticado' };
    }

    return {
      _id: member._id,
      email: member.loginEmail,
      emailVerified: member.loginEmailVerified,
      firstName: member.contact?.firstName || '',
      lastName: member.contact?.lastName || '',
      nickname: member.profile?.nickname || '',
      title: member.profile?.title || '',
      photo: member.profile?.photo?.url || null,
      status: member.status,
      createdDate: member._createdDate,
      lastLoginDate: member.lastLoginDate
    };
  } catch (error) {
    console.error('Erro ao obter informações do membro:', error);
    return { error: error.message };
  }
}

/**
 * Obtém informações públicas de um jogador específico
 * @param {string} memberId - ID do membro
 * @returns {Promise<Object>} Dados públicos do jogador
 */
export async function getPlayerPublicInfo(memberId) {
  try {
    if (!memberId) {
      return { error: 'ID do membro é obrigatório' };
    }

    const member = await wixMembers.members.getMember(memberId, {
      fieldsets: ['FULL']
    });

    if (!member) {
      return { error: 'Jogador não encontrado' };
    }

    // Retorna apenas informações públicas
    return {
      _id: member._id,
      nickname: member.profile?.nickname || member.contact?.firstName || 'Jogador Anônimo',
      title: member.profile?.title || '',
      photo: member.profile?.photo?.url || null,
      createdDate: member._createdDate,
      status: member.status
    };
  } catch (error) {
    console.error('Erro ao obter informações públicas do jogador:', error);
    return { error: error.message };
  }
}

/**
 * Verifica se um membro tem um papel específico
 * @param {string} memberId - ID do membro
 * @param {string} role - Nome do papel
 * @returns {Promise<boolean>}
 */
export async function memberHasRole(memberId, role) {
  try {
    const member = await wixMembers.members.getMember(memberId);
    
    if (!member) {
      return false;
    }

    // Verifica se o membro tem o papel
    const roles = member.roles || [];
    return roles.includes(role);
  } catch (error) {
    console.error('Erro ao verificar papel do membro:', error);
    return false;
  }
}

/**
 * Obtém o ID do membro atual (para uso em operações de dados)
 * @returns {Promise<string|null>}
 */
export async function getCurrentMemberId() {
  try {
    const member = await wixMembers.currentMember.getMember();
    return member ? member._id : null;
  } catch (error) {
    console.error('Erro ao obter ID do membro:', error);
    return null;
  }
}

/**
 * Verifica se o usuário atual é administrador
 * @returns {Promise<boolean>}
 */
export async function isCurrentUserAdmin() {
  try {
    const member = await wixMembers.currentMember.getMember();
    
    if (!member) {
      return false;
    }

    const roles = member.roles || [];
    return roles.includes('Admin') || roles.includes('admin');
  } catch (error) {
    console.error('Erro ao verificar se é admin:', error);
    return false;
  }
}

/**
 * Valida se o usuário está autenticado (para usar em outras funções)
 * @returns {Promise<string>} ID do membro ou lança erro
 */
export async function validateUserAuthentication() {
  try {
    const member = await wixMembers.currentMember.getMember();
    
    if (!member) {
      throw new Error('Usuário não autenticado');
    }

    return member._id;
  } catch (error) {
    throw new Error(`Autenticação falhou: ${error.message}`);
  }
}

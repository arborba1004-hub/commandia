import { publish } from 'wix-realtime-backend';

/**
 * Publica um evento de movimento de um jogador para o canal de movimento
 * @param {string} playerId - ID do jogador que se moveu
 * @param {number} x - Coordenada X (tileX) da nova posição
 * @param {number} y - Coordenada Y (tileY) da nova posição
 */
export async function publishMovement(playerId, x, y) {
  try {
    const channel = `movement_${playerId}`;
    const message = {
      type: 'movement_update',
      playerId: playerId,
      x: x,
      y: y,
      timestamp: Date.now(),
    };

    await publish(channel, message);
    console.log(`✅ Movimento publicado para ${channel}: (${x}, ${y})`);
    return { success: true, channel, message };
  } catch (error) {
    console.error(`❌ Erro ao publicar movimento:`, error);
    return { success: false, error: error.message };
  }
}

/**
 * Publica um evento de ataque para o canal de ataque do alvo
 * @param {string} attackerId - ID do atacante
 * @param {string} targetId - ID do alvo
 * @param {object} result - Resultado do ataque (success, critical, loot, message, etc.)
 */
export async function publishAttack(attackerId, targetId, result) {
  try {
    const channel = `attack_${targetId}`;
    const message = {
      type: 'player_attacked',
      attackerId: attackerId,
      targetId: targetId,
      success: result.success || false,
      critical: result.critical || false,
      loot: result.loot || 0,
      message: result.message || 'Ataque realizado',
      attackerName: result.attackerName || 'Atacante Desconhecido',
      attackerPower: result.attackerPower || 0,
      defenderPower: result.defenderPower || 0,
      timestamp: Date.now(),
    };

    await publish(channel, message);
    console.log(`✅ Ataque publicado para ${channel} por ${attackerId}`);
    return { success: true, channel, message };
  } catch (error) {
    console.error(`❌ Erro ao publicar ataque:`, error);
    return { success: false, error: error.message };
  }
}

/**
 * Publica um evento genérico em um canal específico
 * @param {string} channel - Nome do canal
 * @param {object} message - Mensagem a publicar
 */
export async function publishToChannel(channel, message) {
  try {
    await publish(channel, message);
    console.log(`✅ Mensagem publicada para ${channel}`);
    return { success: true, channel, message };
  } catch (error) {
    console.error(`❌ Erro ao publicar no canal ${channel}:`, error);
    return { success: false, error: error.message };
  }
}

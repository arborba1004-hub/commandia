/**
 * Finaliza uma partida
 * @param {string} matchId - ID da partida
 * @param {string} winnerId - ID do vencedor (opcional)
 * @returns {Promise<Object>} Partida finalizada
 */
export async function finishMatch(matchId, winnerId) {
  try {
    return await updateMatchState(matchId, {
      status: 'finished',
      winnerId: winnerId || null,
      currentTurnPlayerId: null
    });
  } catch (error) {
    console.error('Erro ao finalizar partida:', error);
    throw error;
  }
}

/**
 * Abandona uma partida
 * @param {string} matchId - ID da partida
 * @param {string} playerId - ID do jogador que está abandonando
 * @returns {Promise<Object>} Partida atualizada
 */
export async function abandonMatch(matchId, playerId) {
  try {
    const match = await collection(MATCHES_COLLECTION)
      .findObjects({ matchId })
      .then(results => results[0]);

    if (!match) {
      throw new Error(`Partida ${matchId} não encontrada`);
    }

    const players = JSON.parse(match.players || '[]');
    const remainingPlayers = players.filter(p => p !== playerId);

    // Se só restou um jogador, ele vence
    const winnerId = remainingPlayers.length === 1 ? remainingPlayers[0] : null;

    return await updateMatchState(matchId, {
      players: remainingPlayers,
      status: winnerId ? 'finished' : match.status,
      winnerId: winnerId || null
    });
  } catch (error) {
    console.error('Erro ao abandonar partida:', error);
    throw error;
  }
}

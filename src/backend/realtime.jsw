import { publish } from 'wix-realtime-backend';

/**
 * Publica um evento de ataque em tempo real para o jogador alvo
 * @param {string} targetPlayerId - ID do jogador que está sendo atacado
 * @param {string} attackerName - Nome do atacante
 * @param {number} loot - Quantidade de loot/dinheiro roubado
 * @param {boolean} success - Se o ataque foi bem-sucedido
 * @returns {Promise<void>}
 */
export async function publishAttack(targetPlayerId, attackerName, loot, success) {
  try {
    const channel = `attack_${targetPlayerId}`;
    const message = {
      type: 'attack',
      attackerName,
      loot,
      success,
      timestamp: Date.now()
    };

    await publish(channel, message);
    console.log(`Attack published to ${channel}:`, message);
  } catch (error) {
    console.error('Error publishing attack:', error);
    throw error;
  }
}

/**
 * Publica um evento de defesa bem-sucedida em tempo real

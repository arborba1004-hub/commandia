// LEGACY CODE - DO NOT USE
import wixData from 'wix-data';
import wixMembers from 'wix-members-backend';

/**
 * Cria um novo perfil de jogador
 * @param {Object} profileData - Dados do perfil
 * @returns {Promise<Object>} Perfil criado
 */
export async function createPlayerProfile(profileData) {
  try {
    // Valida autenticação
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    // Verifica se já existe perfil para este membro
    const existingProfile = await wixData.query('Players')
      .eq('memberId', member._id)
      .find();

    if (existingProfile.items.length > 0) {
      return { error: 'Perfil já existe para este usuário', status: 400 };
    }

    // Prepara dados do perfil
    const newProfile = {
      memberId: member._id,
      playerName: profileData.playerName || member.profile?.nickname || 'Jogador',
      level: profileData.level || 1,
      experience: profileData.experience || 0,
      cleanMoney: profileData.cleanMoney || 0,
      dirtyMoney: profileData.dirtyMoney || 0,
      faction: profileData.faction || 'Neutro',
      bio: profileData.bio || '',
      avatar: profileData.avatar || '',
      createdDate: new Date(),
      lastActivityDate: new Date(),
      isActive: true,
      stats: {
        totalKills: 0,
        totalDeaths: 0,
        totalRobberies: 0,
        totalHeists: 0,
        totalBounties: 0
      }
    };

    // Cria o perfil na coleção
    const result = await wixData.insert('Players', newProfile);

    return {
      success: true,
      profile: result,
      message: 'Perfil criado com sucesso'
    };
  } catch (error) {
    console.error('Erro ao criar perfil:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Obtém o perfil do jogador atual
 * @returns {Promise<Object>} Perfil do jogador
 */
export async function getCurrentPlayerProfile() {
  try {
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    const result = await wixData.query('Players')
      .eq('memberId', member._id)
      .find();

    if (result.items.length === 0) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    return {
      success: true,
      profile: result.items[0]
    };
  } catch (error) {
    console.error('Erro ao obter perfil:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Obtém perfil público de um jogador
 * @param {string} playerId - ID do perfil do jogador
 * @returns {Promise<Object>} Dados públicos do perfil
 */
export async function getPlayerPublicProfile(playerId) {
  try {
    if (!playerId) {
      return { error: 'ID do jogador é obrigatório', status: 400 };
    }

    const profile = await wixData.get('Players', playerId);

    if (!profile) {
      return { error: 'Jogador não encontrado', status: 404 };
    }

    // Retorna apenas informações públicas
    return {
      success: true,
      profile: {
        _id: profile._id,
        playerName: profile.playerName,
        level: profile.level,
        faction: profile.faction,
        avatar: profile.avatar,
        bio: profile.bio,
        stats: profile.stats,
        createdDate: profile.createdDate
      }
    };
  } catch (error) {
    console.error('Erro ao obter perfil público:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Atualiza o perfil do jogador atual
 * @param {Object} updateData - Dados a atualizar
 * @returns {Promise<Object>} Perfil atualizado
 */
export async function updateCurrentPlayerProfile(updateData) {
  try {
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    const result = await wixData.query('Players')
      .eq('memberId', member._id)
      .find();

    if (result.items.length === 0) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    const profileId = result.items[0]._id;

    // Campos permitidos para atualização
    const allowedFields = ['playerName', 'bio', 'avatar', 'faction'];
    const updateObj = { _id: profileId };

    allowedFields.forEach(field => {
      if (updateData.hasOwnProperty(field)) {
        updateObj[field] = updateData[field];
      }
    });

    updateObj.lastActivityDate = new Date();

    const updatedProfile = await wixData.update('Players', updateObj);

    return {
      success: true,
      profile: updatedProfile,
      message: 'Perfil atualizado com sucesso'
    };
  } catch (error) {
    console.error('Erro ao atualizar perfil:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Atualiza moedas do jogador (apenas backend)
 * @param {string} playerId - ID do perfil
 * @param {number} cleanMoneyDelta - Mudança em dinheiro limpo
 * @param {number} dirtyMoneyDelta - Mudança em dinheiro sujo
 * @returns {Promise<Object>}
 */
export async function updatePlayerMoney(playerId, cleanMoneyDelta = 0, dirtyMoneyDelta = 0) {
  try {
    const profile = await wixData.get('Players', playerId);

    if (!profile) {
      return { error: 'Jogador não encontrado', status: 404 };
    }

    const newCleanMoney = Math.max(0, profile.cleanMoney + cleanMoneyDelta);
    const newDirtyMoney = Math.max(0, profile.dirtyMoney + dirtyMoneyDelta);

    const updatedProfile = await wixData.update('Players', {
      _id: playerId,
      cleanMoney: newCleanMoney,
      dirtyMoney: newDirtyMoney,
      lastActivityDate: new Date()
    });

    return {
      success: true,
      profile: updatedProfile
    };
  } catch (error) {
    console.error('Erro ao atualizar moedas:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Atualiza experiência e nível do jogador
 * @param {string} playerId - ID do perfil
 * @param {number} experienceDelta - Experiência a adicionar
 * @returns {Promise<Object>}
 */
export async function updatePlayerExperience(playerId, experienceDelta) {
  try {
    const profile = await wixData.get('Players', playerId);

    if (!profile) {
      return { error: 'Jogador não encontrado', status: 404 };
    }

    const newExperience = profile.experience + experienceDelta;
    const experiencePerLevel = 1000;
    const newLevel = Math.floor(newExperience / experiencePerLevel) + 1;

    const updatedProfile = await wixData.update('Players', {
      _id: playerId,
      experience: newExperience,
      level: newLevel,
      lastActivityDate: new Date()
    });

    return {
      success: true,
      profile: updatedProfile,
      leveledUp: newLevel > profile.level,
      newLevel: newLevel
    };
  } catch (error) {
    console.error('Erro ao atualizar experiência:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Atualiza estatísticas do jogador
 * @param {string} playerId - ID do perfil
 * @param {Object} statsDelta - Mudanças nas estatísticas
 * @returns {Promise<Object>}
 */
export async function updatePlayerStats(playerId, statsDelta) {
  try {
    const profile = await wixData.get('Players', playerId);

    if (!profile) {
      return { error: 'Jogador não encontrado', status: 404 };
    }

    const currentStats = profile.stats || {};
    const newStats = {
      totalKills: (currentStats.totalKills || 0) + (statsDelta.totalKills || 0),
      totalDeaths: (currentStats.totalDeaths || 0) + (statsDelta.totalDeaths || 0),
      totalRobberies: (currentStats.totalRobberies || 0) + (statsDelta.totalRobberies || 0),
      totalHeists: (currentStats.totalHeists || 0) + (statsDelta.totalHeists || 0),
      totalBounties: (currentStats.totalBounties || 0) + (statsDelta.totalBounties || 0)
    };

    const updatedProfile = await wixData.update('Players', {
      _id: playerId,
      stats: newStats,
      lastActivityDate: new Date()
    });

    return {
      success: true,
      profile: updatedProfile
    };
  } catch (error) {
    console.error('Erro ao atualizar estatísticas:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Lista os top jogadores por nível
 * @param {number} limit - Número de jogadores a retornar
 * @returns {Promise<Object>}
 */
export async function getTopPlayersByLevel(limit = 10) {
  try {
    const result = await wixData.query('Players')
      .descending('level')
      .limit(limit)
      .find();

    const topPlayers = result.items.map(player => ({
      _id: player._id,
      playerName: player.playerName,
      level: player.level,
      experience: player.experience,
      faction: player.faction,
      avatar: player.avatar
    }));

    return {
      success: true,
      players: topPlayers
    };
  } catch (error) {
    console.error('Erro ao obter top jogadores:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Busca jogadores por nome
 * @param {string} searchTerm - Termo de busca
 * @param {number} limit - Limite de resultados
 * @returns {Promise<Object>}
 */
export async function searchPlayers(searchTerm, limit = 20) {
  try {
    if (!searchTerm || searchTerm.trim().length === 0) {
      return { error: 'Termo de busca é obrigatório', status: 400 };
    }

    const result = await wixData.query('Players')
      .contains('playerName', searchTerm)
      .limit(limit)
      .find();

    const players = result.items.map(player => ({
      _id: player._id,
      playerName: player.playerName,
      level: player.level,
      faction: player.faction,
      avatar: player.avatar
    }));

    return {
      success: true,
      players: players,
      count: players.length
    };
  } catch (error) {
    console.error('Erro ao buscar jogadores:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * ⚡ ARQUIVO BACKEND WIX - PUBLICADOR DE MOVIMENTOS
 * 
 * Este arquivo "ouve" quando um jogador se move e avisa todos os outros
 * em tempo real usando o sistema de realtime do Wix.
 * 
 * COMO FUNCIONA:
 * 1. Quando você clica no mapa e se move, o GamePage.tsx chama esta função
 * 2. Esta função publica a nova posição em um "canal" (como um grupo de chat)
 * 3. Todos os outros jogadores recebem a mensagem em tempo real
 */

import { realtime } from 'wix-realtime-backend';

/**
 * 🎯 FUNÇÃO PRINCIPAL: Publicar movimento do jogador
 * 
 * Parâmetros:
 * - playerId: ID único do jogador que se moveu
 * - playerName: Nome do jogador
 * - tileX: Posição X no mapa (coluna)
 * - tileY: Posição Y no mapa (linha)
 * 
 * Exemplo de uso (do frontend):
 * await publishPlayerMovement({
 *   playerId: 'user123',
 *   playerName: 'CAPO GHOST',
 *   tileX: 40,
 *   tileY: 20
 * });
 */
export async function publishPlayerMovement(data) {
  try {
    const { playerId, playerName, tileX, tileY } = data;

    // ✅ Validar dados
    if (!playerId || tileX === undefined || tileY === undefined) {
      console.error('❌ Dados incompletos para publicar movimento');
      return { success: false, error: 'Dados incompletos' };
    }

    // 📡 Nome do canal onde vamos publicar
    // Todos os jogadores se inscrevem em "movement_PLAYER_ID"
    const movementChannel = `movement_${playerId}`;

    // 📢 Mensagem que será enviada
    const message = {
      type: 'movement_update',
      playerId: playerId,
      playerName: playerName || 'JOGADOR',
      x: tileX,
      y: tileY,
      timestamp: Date.now(),
    };

    // 🚀 Publicar a mensagem no canal
    await realtime.publish(movementChannel, message);

    console.log(`✅ Movimento publicado: ${playerName} → (${tileX}, ${tileY})`);
    return { success: true, message: 'Movimento publicado com sucesso' };
  } catch (error) {
    console.error('❌ Erro ao publicar movimento:', error);
    return { success: false, error: error.message };
  }
}

/**
 * 🎯 FUNÇÃO AUXILIAR: Publicar múltiplos movimentos (para sincronização)
 * 
 * Use esta função se vários jogadores se movem ao mesmo tempo
 */
export async function publishMultipleMovements(movements) {
  try {
    const results = [];

    for (const movement of movements) {
      const result = await publishPlayerMovement(movement);
      results.push(result);
    }

    console.log(`✅ ${results.length} movimentos publicados`);
    return { success: true, results };
  } catch (error) {
    console.error('❌ Erro ao publicar múltiplos movimentos:', error);
    return { success: false, error: error.message };
  }
}

/**
 * 🎯 FUNÇÃO AUXILIAR: Publicar movimento com validação de distância
 * 
 * Evita que o jogador se teleporte (move muito longe de uma vez)
 * Distância máxima padrão: 5 tiles
 */
export async function publishPlayerMovementWithValidation(data, maxDistance = 5) {
  try {
    const { playerId, playerName, tileX, tileY, previousX, previousY } = data;

    // Se temos posição anterior, validar distância
    if (previousX !== undefined && previousY !== undefined) {
      const distance = Math.sqrt(
        Math.pow(tileX - previousX, 2) + Math.pow(tileY - previousY, 2)
      );

      if (distance > maxDistance) {
        console.warn(`⚠️ Movimento suspeito: distância ${distance} > ${maxDistance}`);
        return { success: false, error: 'Movimento muito longe (possível hack)' };
      }
    }

    // Se passou na validação, publicar normalmente
    return await publishPlayerMovement(data);
  } catch (error) {
    console.error('❌ Erro na validação de movimento:', error);
    return { success: false, error: error.message };
  }
}

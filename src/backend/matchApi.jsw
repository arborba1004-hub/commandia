// backend/matchApi.jsw
// API endpoints para gerenciar partidas

import { ok, created, badRequest, serverError } from 'wix-http-functions';
import * as matchService from './matchService.jsw';

/**
 * POST /api/match/create
 * Cria uma nova partida
 */
export async function post_create(request) {
  try {
    const body = request.body.json();
    const { players, gameData } = body;

    if (!players || !Array.isArray(players) || players.length < 2) {
      return badRequest({
        error: 'Pelo menos 2 jogadores são necessários'
      });
    }

    const match = await matchService.createMatch({
      players,
      gameData: gameData || {}
    });

    return created({
      success: true,
      match
    });
  } catch (error) {
    console.error('Erro ao criar partida:', error);
    return serverError({
      error: error.message || 'Erro ao criar partida'
    });
  }
}

/**
 * POST /api/match/state
 * Obtém o estado atual da partida
 */
export async function post_state(request) {
  try {
    const body = request.body.json();
    const { matchId } = body;

    if (!matchId) {
      return badRequest({
        error: 'matchId é obrigatório'
      });
    }

    const match = await matchService.getMatchState(matchId);

    return ok({
      success: true,
      match
    });
  } catch (error) {
    console.error('Erro ao obter estado da partida:', error);
    return serverError({
      error: error.message || 'Erro ao obter estado da partida'
    });
  }
}

/**
 * POST /api/match/move
 * Processa uma jogada
 */
export async function post_move(request) {
  try {
    const body = request.body.json();
    const { matchId, playerId, moveData } = body;

    if (!matchId || !playerId || !moveData) {
      return badRequest({
        error: 'matchId, playerId e moveData são obrigatórios'
      });
    }

    const match = await matchService.makeMove(matchId, playerId, moveData);

    return ok({
      success: true,
      match
    });
  } catch (error) {
    console.error('Erro ao processar jogada:', error);
    return serverError({
      error: error.message || 'Erro ao processar jogada'
    });
  }
}

/**
 * POST /api/match/abandon
 * Abandona uma partida
 */
export async function post_abandon(request) {
  try {
    const body = request.body.json();
    const { matchId, playerId } = body;

    if (!matchId || !playerId) {
      return badRequest({
        error: 'matchId e playerId são obrigatórios'
      });
    }

    const match = await matchService.abandonMatch(matchId, playerId);

    return ok({
      success: true,
      match
    });
  } catch (error) {
    console.error('Erro ao abandonar partida:', error);
    return serverError({
      error: error.message || 'Erro ao abandonar partida'
    });
  }
}

/**
 * POST /api/match/finish
 * Finaliza uma partida
 */
export async function post_finish(request) {
  try {
    const body = request.body.json();
    const { matchId, winnerId } = body;

    if (!matchId) {
      return badRequest({
        error: 'matchId é obrigatório'
      });
    }

    const match = await matchService.finishMatch(matchId, winnerId);

    return ok({
      success: true,
      match
    });
  } catch (error) {
    console.error('Erro ao finalizar partida:', error);
    return serverError({
      error: error.message || 'Erro ao finalizar partida'
    });
  }
}

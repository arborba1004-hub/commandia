// backend/matchService.jsw
// Serviço para gerenciar partidas e sincronização em tempo real

import { collection } from 'wix-data';
// ⚠️ DESABILITADO - Causava loop infinito na publicação do Wix
// import { publish } from 'wix-realtime';

const MATCHES_COLLECTION = 'partidas';

/**
 * Cria uma nova partida
 * @param {Object} matchData - Dados da partida
 * @returns {Promise<Object>} Partida criada
 */
export async function createMatch(matchData) {
  try {
    const matchId = generateMatchId();
    
    const newMatch = {
      matchId,
      players: JSON.stringify(matchData.players || []),
      status: 'waiting', // waiting, inProgress, finished
      currentTurnPlayerId: matchData.players?.[0] || null,
      gameData: JSON.stringify(matchData.gameData || {}),
      createdAt: new Date(),
      updatedAt: new Date(),
      winnerId: null
    };

    const result = await collection(MATCHES_COLLECTION).insert(newMatch);
    
    // ⚠️ DESABILITADO - Publicação em tempo real removida para evitar loop infinito
    // await publishMatchUpdate(matchId, {
    //   event: 'matchCreated',
    //   match: newMatch
    // });

    return result;
  } catch (error) {
    console.error('Erro ao criar partida:', error);
    throw error;
  }
}

/**
 * Atualiza o estado da partida e sincroniza com todos os jogadores
 * @param {string} matchId - ID da partida
 * @param {Object} updateData - Dados a atualizar
 * @returns {Promise<Object>} Partida atualizada
 */
export async function updateMatchState(matchId, updateData) {
  try {
    // Buscar partida atual
    const match = await collection(MATCHES_COLLECTION)
      .findObjects({ matchId })
      .then(results => results[0]);

    if (!match) {
      throw new Error(`Partida ${matchId} não encontrada`);
    }

    // Preparar dados atualizados
    const updatedMatch = {
      ...match,
      ...updateData,
      updatedAt: new Date(),
      // Garantir que campos JSON sejam strings
      players: typeof updateData.players === 'string' 
        ? updateData.players 
        : JSON.stringify(updateData.players || JSON.parse(match.players || '[]')),
      gameData: typeof updateData.gameData === 'string'
        ? updateData.gameData
        : JSON.stringify(updateData.gameData || JSON.parse(match.gameData || '{}'))
    };

    // Atualizar no banco de dados
    await collection(MATCHES_COLLECTION).update(match._id, updatedMatch);

    // ⚠️ DESABILITADO - Publicação em tempo real removida para evitar loop infinito
    // await publishMatchUpdate(matchId, {
    //   event: 'stateUpdated',
    //   match: updatedMatch,
    //   timestamp: new Date().toISOString()
    // });

    return updatedMatch;
  } catch (error) {
    console.error('Erro ao atualizar estado da partida:', error);
    throw error;
  }
}

/**
 * Processa uma jogada do jogador
 * @param {string} matchId - ID da partida
 * @param {string} playerId - ID do jogador
 * @param {Object} moveData - Dados da jogada
 * @returns {Promise<Object>} Estado atualizado
 */
export async function makeMove(matchId, playerId, moveData) {
  try {
    // Buscar partida
    const match = await collection(MATCHES_COLLECTION)
      .findObjects({ matchId })
      .then(results => results[0]);

    if (!match) {
      throw new Error(`Partida ${matchId} não encontrada`);
    }

    // Validar se é a vez do jogador
    if (match.currentTurnPlayerId !== playerId) {
      throw new Error(`Não é a vez do jogador ${playerId}`);
    }

    // Parsear dados do jogo
    const gameData = JSON.parse(match.gameData || '{}');
    const players = JSON.parse(match.players || '[]');

    // Aplicar a jogada (lógica customizável)
    const updatedGameData = applyMove(gameData, playerId, moveData);

    // Determinar próximo jogador
    const currentPlayerIndex = players.indexOf(playerId);
    const nextPlayerIndex = (currentPlayerIndex + 1) % players.length;
    const nextPlayerId = players[nextPlayerIndex];

    // Verificar se há vencedor
    const winner = checkWinner(updatedGameData, players);

    // Atualizar partida
    const updateData = {
      gameData: updatedGameData,
      currentTurnPlayerId: winner ? null : nextPlayerId,
      status: winner ? 'finished' : 'inProgress',
      winnerId: winner || null
    };

    const updatedMatch = await updateMatchState(matchId, updateData);

    // ⚠️ DESABILITADO - Publicação em tempo real removida para evitar loop infinito
    // await publishMatchUpdate(matchId, {
    //   event: 'moveMade',
    //   playerId,
    //   move: moveData,
    //   nextTurn: nextPlayerId,
    //   winner: winner || null,
    //   gameState: updatedGameData,
    //   timestamp: new Date().toISOString()
    // });

    return updatedMatch;
  } catch (error) {
    console.error('Erro ao processar jogada:', error);
    throw error;
  }
}

/**
 * Obtém o estado atual da partida
 * @param {string} matchId - ID da partida
 * @returns {Promise<Object>} Dados da partida
 */
export async function getMatchState(matchId) {
  try {
    const match = await collection(MATCHES_COLLECTION)
      .findObjects({ matchId })
      .then(results => results[0]);

    if (!match) {
      throw new Error(`Partida ${matchId} não encontrada`);
    }

    // Parsear campos JSON
    return {
      ...match,
      players: JSON.parse(match.players || '[]'),
      gameData: JSON.parse(match.gameData || '{}')
    };
  } catch (error) {
    console.error('Erro ao obter estado da partida:', error);
    throw error;
  }
}


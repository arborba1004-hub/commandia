// gameOperations.jsw - Operações de Jogo (Roubo, Heist, Bounty, etc)
import wixData from 'wix-data';
import wixMembers from 'wix-members-backend';

/**
 * Registra uma transação de jogo
 * @param {string} playerId - ID do perfil do jogador
 * @param {string} transactionType - Tipo de transação (robbery, heist, bounty, etc)
 * @param {number} amount - Valor da transação
 * @param {string} currency - Tipo de moeda (clean, dirty)
 * @param {string} description - Descrição da transação
 * @returns {Promise<Object>}
 */
export async function recordGameTransaction(playerId, transactionType, amount, currency, description) {
  try {
    // Valida autenticação
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    // Obtém o perfil do jogador
    const playerProfile = await wixData.get('Players', playerId);
    if (!playerProfile) {
      return { error: 'Perfil do jogador não encontrado', status: 404 };
    }

    // Verifica se é o dono do perfil
    if (playerProfile.memberId !== member._id) {
      return { error: 'Você não tem permissão para esta operação', status: 403 };
    }

    // Cria a transação
    const transaction = {
      memberId: member._id,
      playerId: playerId,
      transactionType: transactionType,
      amount: amount,
      currency: currency,
      description: description,
      timestamp: new Date(),
      status: 'completed'
    };

    const result = await wixData.insert('GameTransactions', transaction);

    return {
      success: true,
      transaction: result
    };
  } catch (error) {
    console.error('Erro ao registrar transação:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Executa um roubo (robbery)
 * @param {string} playerId - ID do perfil do jogador
 * @param {string} targetPlayerId - ID do perfil do alvo
 * @param {number} amount - Valor do roubo
 * @returns {Promise<Object>}
 */
export async function executeRobbery(playerId, targetPlayerId, amount) {
  try {
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    // Obtém perfis
    const attacker = await wixData.get('Players', playerId);
    const target = await wixData.get('Players', targetPlayerId);

    if (!attacker || !target) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    // Verifica se é o dono
    if (attacker.memberId !== member._id) {
      return { error: 'Você não tem permissão', status: 403 };
    }

    // Verifica se o alvo tem dinheiro suficiente
    if (target.dirtyMoney < amount) {
      return { error: 'Alvo não tem dinheiro suficiente', status: 400 };
    }

    // Executa o roubo
    const successChance = 0.7; // 70% de chance de sucesso
    const success = Math.random() < successChance;

    if (success) {
      // Atualiza dinheiro do atacante
      await wixData.update('Players', {
        _id: playerId,
        dirtyMoney: attacker.dirtyMoney + amount,
        lastActivityDate: new Date()
      });

      // Atualiza dinheiro do alvo
      await wixData.update('Players', {
        _id: targetPlayerId,
        dirtyMoney: target.dirtyMoney - amount,
        lastActivityDate: new Date()
      });

      // Registra transação para o atacante
      await wixData.insert('GameTransactions', {
        memberId: member._id,
        playerId: playerId,
        transactionType: 'robbery_success',
        amount: amount,
        currency: 'dirty',
        description: `Roubo bem-sucedido de ${target.playerName}`,
        timestamp: new Date(),
        status: 'completed'
      });

      // Atualiza estatísticas
      const newStats = {
        ...attacker.stats,
        totalRobberies: (attacker.stats?.totalRobberies || 0) + 1
      };

      await wixData.update('Players', {
        _id: playerId,
        stats: newStats
      });

      return {
        success: true,
        result: 'robbery_success',
        amountStolen: amount,
        message: `Você roubou $${amount} de ${target.playerName}`
      };
    } else {
      // Roubo falhou - atacante perde dinheiro
      const penalty = Math.floor(amount * 0.5);

      await wixData.update('Players', {
        _id: playerId,
        dirtyMoney: Math.max(0, attacker.dirtyMoney - penalty),
        lastActivityDate: new Date()
      });

      return {
        success: false,
        result: 'robbery_failed',
        penalty: penalty,
        message: `Roubo falhou! Você perdeu $${penalty} como penalidade`
      };
    }
  } catch (error) {
    console.error('Erro ao executar roubo:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Executa um heist (assalto planejado)
 * @param {string} playerId - ID do perfil do jogador
 * @param {string} heistType - Tipo de heist
 * @param {number} difficulty - Dificuldade (1-5)
 * @returns {Promise<Object>}
 */
export async function executeHeist(playerId, heistType, difficulty) {
  try {
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    const player = await wixData.get('Players', playerId);
    if (!player) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    if (player.memberId !== member._id) {
      return { error: 'Você não tem permissão', status: 403 };
    }

    // Calcula recompensa baseada na dificuldade
    const baseReward = 1000;
    const reward = baseReward * difficulty;
    const successChance = 1 - (difficulty * 0.15); // Quanto mais difícil, menos chance

    const success = Math.random() < successChance;

    if (success) {
      // Heist bem-sucedido
      await wixData.update('Players', {
        _id: playerId,
        dirtyMoney: player.dirtyMoney + reward,
        experience: player.experience + (reward / 10),
        lastActivityDate: new Date()
      });

      // Atualiza estatísticas
      const newStats = {
        ...player.stats,
        totalHeists: (player.stats?.totalHeists || 0) + 1
      };

      await wixData.update('Players', {
        _id: playerId,
        stats: newStats
      });

      // Registra transação
      await wixData.insert('GameTransactions', {
        memberId: member._id,
        playerId: playerId,
        transactionType: 'heist_success',
        amount: reward,
        currency: 'dirty',
        description: `Heist bem-sucedido: ${heistType} (Dificuldade: ${difficulty})`,
        timestamp: new Date(),
        status: 'completed'
      });

      return {
        success: true,
        reward: reward,
        experience: Math.floor(reward / 10),
        message: `Heist bem-sucedido! Você ganhou $${reward}`
      };
    } else {
      // Heist falhou
      const penalty = Math.floor(reward * 0.3);

      await wixData.update('Players', {
        _id: playerId,
        dirtyMoney: Math.max(0, player.dirtyMoney - penalty),
        lastActivityDate: new Date()
      });

      return {
        success: false,
        penalty: penalty,
        message: `Heist falhou! Você perdeu $${penalty}`
      };
    }
  } catch (error) {
    console.error('Erro ao executar heist:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Coloca uma recompensa (bounty) em um jogador
 * @param {string} playerId - ID do jogador que coloca a recompensa
 * @param {string} targetPlayerId - ID do alvo
 * @param {number} amount - Valor da recompensa
 * @returns {Promise<Object>}
 */
export async function placeBounty(playerId, targetPlayerId, amount) {
  try {
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    const player = await wixData.get('Players', playerId);
    const target = await wixData.get('Players', targetPlayerId);

    if (!player || !target) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    if (player.memberId !== member._id) {
      return { error: 'Você não tem permissão', status: 403 };
    }

    // Verifica se tem dinheiro suficiente
    if (player.cleanMoney < amount) {
      return { error: 'Você não tem dinheiro limpo suficiente', status: 400 };
    }

    // Deduz o dinheiro
    await wixData.update('Players', {
      _id: playerId,
      cleanMoney: player.cleanMoney - amount,
      lastActivityDate: new Date()
    });

    // Registra a recompensa
    const bounty = {
      memberId: member._id,
      playerId: playerId,
      targetPlayerId: targetPlayerId,
      targetName: target.playerName,
      amount: amount,
      createdDate: new Date(),
      status: 'active'
    };

    const result = await wixData.insert('Bounties', bounty);

    return {
      success: true,
      bounty: result,
      message: `Recompensa de $${amount} colocada em ${target.playerName}`
    };
  } catch (error) {
    console.error('Erro ao colocar recompensa:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Obtém histórico de transações do jogador
 * @param {string} playerId - ID do perfil
 * @param {number} limit - Limite de resultados
 * @returns {Promise<Object>}
 */
export async function getPlayerTransactionHistory(playerId, limit = 50) {
  try {
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    const player = await wixData.get('Players', playerId);
    if (!player) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    // Verifica se é o dono
    if (player.memberId !== member._id) {
      return { error: 'Você não tem permissão', status: 403 };
    }

    const result = await wixData.query('GameTransactions')
      .eq('playerId', playerId)
      .descending('timestamp')
      .limit(limit)
      .find();

    return {
      success: true,
      transactions: result.items,
      count: result.items.length
    };
  } catch (error) {
    console.error('Erro ao obter histórico:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Obtém estatísticas de combate do jogador
 * @param {string} playerId - ID do perfil
 * @returns {Promise<Object>}
 */
export async function getPlayerCombatStats(playerId) {
  try {
    const player = await wixData.get('Players', playerId);
    if (!player) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    const stats = player.stats || {};
    const kdr = stats.totalDeaths > 0 ? (stats.totalKills / stats.totalDeaths).toFixed(2) : stats.totalKills;

    return {
      success: true,
      stats: {
        totalKills: stats.totalKills || 0,
        totalDeaths: stats.totalDeaths || 0,
        killDeathRatio: kdr,
        totalRobberies: stats.totalRobberies || 0,
        totalHeists: stats.totalHeists || 0,
        totalBounties: stats.totalBounties || 0
      }
    };
  } catch (error) {
    console.error('Erro ao obter estatísticas:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Adiciona item ao inventário do jogador
 * @param {string} playerId - ID do perfil
 * @param {string} itemId - ID do item
 * @param {string} itemName - Nome do item
 * @param {string} itemType - Tipo do item (weapon, vehicle, accessory)
 * @param {number} quantity - Quantidade
 * @returns {Promise<Object>}
 */
export async function addItemToInventory(playerId, itemId, itemName, itemType, quantity = 1) {
  try {
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    const player = await wixData.get('Players', playerId);
    if (!player) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    if (player.memberId !== member._id) {
      return { error: 'Você não tem permissão', status: 403 };
    }

    // Verifica se o item já existe no inventário
    const existingItem = await wixData.query('PlayerInventory')
      .eq('playerId', playerId)
      .eq('itemId', itemId)
      .find();

    if (existingItem.items.length > 0) {
      // Atualiza quantidade
      const item = existingItem.items[0];
      await wixData.update('PlayerInventory', {
        _id: item._id,
        quantity: item.quantity + quantity
      });

      return {
        success: true,
        message: 'Item adicionado ao inventário'
      };
    } else {
      // Cria novo item no inventário
      const inventoryItem = {
        memberId: member._id,
        playerId: playerId,
        itemId: itemId,
        itemName: itemName,
        quantity: quantity,
        itemType: itemType,
        acquiredDate: new Date()
      };

      const result = await wixData.insert('PlayerInventory', inventoryItem);

      return {
        success: true,
        item: result,
        message: 'Item adicionado ao inventário'
      };
    }
  } catch (error) {
    console.error('Erro ao adicionar item:', error);
    return { error: error.message, status: 500 };
  }
}

/**
 * Obtém inventário do jogador
 * @param {string} playerId - ID do perfil
 * @returns {Promise<Object>}
 */
export async function getPlayerInventory(playerId) {
  try {
    const member = await wixMembers.currentMember.getMember();
    if (!member) {
      return { error: 'Usuário não autenticado', status: 401 };
    }

    const player = await wixData.get('Players', playerId);
    if (!player) {
      return { error: 'Perfil não encontrado', status: 404 };
    }

    if (player.memberId !== member._id) {
      return { error: 'Você não tem permissão', status: 403 };
    }

    const result = await wixData.query('PlayerInventory')
      .eq('playerId', playerId)
      .find();

    return {
      success: true,
      inventory: result.items,
      totalItems: result.items.length
    };
  } catch (error) {
    console.error('Erro ao obter inventário:', error);
    return { error: error.message, status: 500 };
  }
}
